# ─── Vercel KV (Redis) ───────────────────────────────────────────────────────
# Get these from: Vercel Dashboard → Storage → Create KV Database → .env.local
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# ─── Cron Security ───────────────────────────────────────────────────────────
# Set any random secret string — used to protect the cron endpoint
CRON_SECRET=your_random_secret_here_change_this

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_TITLE=NSE Terminal
